import cv2, numpy as np, matplotlib.pyplot as plt
img = cv2.imread(r"C:\Users\anu\OneDrive\Pictures\flowr.webp", 0)
h, w = img.shape
ahe = np.zeros_like(img)
for i in range(0, h, 32):
    for j in range(0, w, 32):
        ahe[i:i+32, j:j+32] = cv2.equalizeHist(img[i:i+32, j:j+32])

plt.subplot(1,2,1); plt.imshow(img, cmap='gray'); plt.title('Original'); plt.axis('off')
plt.subplot(1,2,2); plt.imshow(ahe, cmap='gray'); plt.title('AHE'); plt.axis('off')
plt.show()
